//****************************************************************************
//  Copyright (c) 2010-2026  Derell Licht
//
//****************************************************************************
//  Interesting notes about this file:
//
//  > SS_NOTIFY and "Static" controls
//    If SS_NOTIFY is not specified in the control styles,
//    you cannot attach tooltips to the control.
//
//*********************************************************************************************************
// DS_3DLOOK
//     Gives the dialog box a non-bold font and draws three-dimensional borders 
//     around control windows in the dialog box.
//     The DS_3DLOOK style is required only by Microsoft Win32�-based applications compiled 
//     for system versions earlier than Windows 95 or Windows NT� 4.0. 
//     The system automatically applies the three-dimensional look to dialog boxes created by 
//     applications compiled for current versions of the system.
//*********************************************************************************************************
// What's the deal with the DS_SHELLFONT flag?
// 
// It indicates that you want the Windows 2000 default shell font. 
// But that doesn't mean that you're going to get it.
// 
// In order to indicate that you would like the "Windows 2000" look for your 
// dialog, you have to do three things and hope for a fourth:
// 
// > Use a DIALOGEX template instead of a DIALOG template.
// > Set the DS_SHELLFONT flag in your dialog styles.
// > Set the dialog font to "MS Shell Dlg".
// > Hope that you're running on Windows 2000 or later on a system that has the
//   new Windows 2000 dialog font enabled. 
// 
// If all four conditions are satisfied, then your dialog gets the "Windows 2000"
// look. If any condition fails, then you get the "classic" dialog font. 
//*********************************************************************************************************
// 04/26/13 12:45  On Win7, WS_DLGFRAME and WS_CAPTION seem to create identical dialogs !
// > WS_DLGFRAME  Creates a window with a double border but no title.
// > WS_BORDER    Creates a window that has a border.
// > WS_CAPTION   Creates a window that has a title bar (implies the WS_BORDER style). 
//                Cannot be used with the WS_DLGFRAME style.
// > WS_SYSMENU   Among other things, adds the CLOSE button on title bar
//                WS_SYSMENU also needed in order to show program icon on title bar
//*********************************************************************************************************
//  WS_THICKFRAME   Creates a window with a thick frame that can be used to size the window.
//  04/26/13 - initially, one of these other flags was over-riding WS_THICKFRAME
//*********************************************************************************************************
#include <windows.h>

#include "version.h"
#include "resource.h"

BM_BALLS  BITMAP  DISCARDABLE     "balls.bmp"

IDI_APPICON   ICON    bclock.ico

//*******************************************************************
IDD_MAIN_DIALOG DIALOGEX 400, 200, 180, 80
// STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
STYLE DS_MODALFRAME | WS_VISIBLE | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX
EXSTYLE WS_EX_APPWINDOW
CAPTION "BinClock binary clock"
FONT 11, "Times New Roman"
BEGIN
   LTEXT           "hours:",    IDS_HOURS,   20, 17, 30,  9, SS_NOTIFY
   CTEXT           " ",         IDC_HOURS,   50, 17, 12,  9, SS_SUNKEN | SS_NOTIFY
                                             
   LTEXT           "minutes:",  IDS_MINS,    20, 29, 30,  9, SS_NOTIFY
   CTEXT           " ",         IDC_MINS,    50, 29, 12,  9, SS_SUNKEN | SS_NOTIFY

   LTEXT           "seconds:",  IDS_SECS,    20, 41, 30,  9, SS_NOTIFY
   CTEXT           " ",         IDC_SECS,    50, 41, 12,  9, SS_SUNKEN | SS_NOTIFY
   
   PUSHBUTTON      "About",     IDB_ABOUT,   20, 60, 43, 10
   PUSHBUTTON      "Close",     IDB_CLOSE,  100, 60, 50, 10
END

//  normal method for displaying LEDs
   // CONTROL        "",IDC_CONN_LED,"Static",
   //                WS_CHILD | WS_VISIBLE | SS_ICON | SS_CENTERIMAGE | SS_REALSIZEIMAGE | SS_NOTIFY,
   //                LED_M_X0,LED_MOFS_Y,10,8

//*******************************************************************
IDD_ABOUT DIALOGEX DISCARDABLE  550, 300, 200, 100
// STYLE DS_MODALFRAME | WS_POPUP | WS_VISIBLE | WS_CAPTION | WS_SYSMENU
CAPTION "BinClock binary clock"
FONT 10, "Times New Roman"
BEGIN
//  Note about the ICON control...
//  The "optional" parameters are *not* optional when building with Clang windres.exe ...
// ICON text, id, x, y [, width, height, style [, extended-style]]
    ICON            IDI_APPICON,                                    IDC_STATIC,     9, 14,   0,  0, SS_ICON
    LTEXT           "BinClock Binary Clock",                        IDC_STATIC,    36, 15,  72, 10
    LTEXT           VerNum,                                         IDC_VERNUM,   109, 15,  50, 10
    LTEXT           "Copyright (c) 2007-2026",                      IDC_STATIC,    36, 29,  76, 10
    LTEXT           "Derell Licht",                                 IDC_STATIC,   113, 29,  40, 10
    LTEXT           "http://derelllicht.42web.io/freeware.html",    IDC_WEBLINK,   36, 43, 140, 10
    LTEXT           "https://github.com/DerellLicht/binclock_redux",IDC_WEBLINK2,  36, 55, 150, 10
    DEFPUSHBUTTON   "Close",                                        IDOK,          36, 75, 100, 14
END

/////////////////////////////////////////////////////////////////////////////
// 
// Version
//

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
#ifdef _DEBUG
 FILEFLAGS 0x1L
#else
 FILEFLAGS 0x0L
#endif
 FILEOS 0x4L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "Comments", "BinClock - Binary Clock program."
            VALUE "CompanyName", "Cathartes Aura"
            VALUE "FileDescription", "BinClock - Binary Clock program"
            VALUE "FileVersion", VerNum
            VALUE "InternalName", "BinClock"
            VALUE "LegalCopyright", "Copyright (c) 2007-2026"
            VALUE "OriginalFilename", "binclock.exe"
            VALUE "ProductName", "BinClock - Binary Clock program"
            VALUE "ProductVersion", VerNum
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END


